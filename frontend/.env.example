# DNS Shield AI — Frontend Environment Configuration
# Copy this file to .env or .env.production

# Backend REST API URL:
# Leave blank or omit in development to use Vite's built-in dev proxy (/api -> http://127.0.0.1:8001)
# In production, set to your deployed backend service URL (e.g. Render, Railway, AWS ECS)
VITE_API_URL=https://my-dns-shield-backend.onrender.com
