# DNS Shield AI — Production & Development Environment Configuration
# Copy this file to .env and adjust variables as needed

# Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# Server Port (default 8001)
PORT=8001

# Allowed CORS origins (comma-separated list for production frontend domains)
CORS_ORIGINS=https://my-dns-shield-app.vercel.app,http://localhost:5173,http://localhost:5174

# Database Connection URL:
# For local SQLite: sqlite:///./data/dns_shield.db
# For production PostgreSQL: postgresql://username:password@hostname:5432/dns_shield
DATABASE_URL=sqlite:///./data/dns_shield.db

# Security & API Ingestion Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-in-production-min-32-chars
INGESTION_API_KEY=shield-sec-dev-api-key-2026

# Model & Data Storage
DATA_DIR=./data
MODEL_PATH=./data/models/dns_tunnel_rf_model.joblib
METRICS_PATH=./data/models/model_metrics.json

# Thresholds
DEFAULT_ALERT_THRESHOLD=65.0
DNS_ENRICHMENT_TIMEOUT_SEC=2.0
MAX_UPLOAD_SIZE_BYTES=15728640
